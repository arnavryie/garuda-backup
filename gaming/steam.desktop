[Desktop Entry]
Name=Steam
Comment=Application for managing and playing games on Steam
Exec=/usr/bin/steam -cef-disable-gpu %U
Icon=steam
Terminal=false
Type=Application
Categories=Network;FileTransfer;Game;
MimeType=x-scheme-handler/steam;x-scheme-handler/steamlink;
Actions=Store;Community;Library;Servers;Screenshots;News;Settings;BigPicture;Friends;
PrefersNonDefaultGPU=false
X-KDE-RunOnDiscreteGpu=false

[Desktop Action Store]
Name=Store
Exec=/usr/bin/steam -cef-disable-gpu steam://store

[Desktop Action Community]
Name=Community
Exec=/usr/bin/steam -cef-disable-gpu steam://url/CommunityHome/

[Desktop Action Library]
Name=Library
Exec=/usr/bin/steam -cef-disable-gpu steam://open/games

[Desktop Action Servers]
Name=Servers
Exec=/usr/bin/steam -cef-disable-gpu steam://open/servers

[Desktop Action Screenshots]
Name=Screenshots
Exec=/usr/bin/steam -cef-disable-gpu steam://open/screenshots

[Desktop Action News]
Name=News
Exec=/usr/bin/steam -cef-disable-gpu steam://openurl/https://store.steampowered.com/news

[Desktop Action Settings]
Name=Settings
Exec=/usr/bin/steam -cef-disable-gpu steam://open/settings

[Desktop Action BigPicture]
Name=Big Picture
Exec=/usr/bin/steam -cef-disable-gpu steam://open/bigpicture

[Desktop Action Friends]
Name=Friends
Exec=/usr/bin/steam -cef-disable-gpu steam://open/friends
