[Unit]
Description=NoiseTorch Smart Battery & Hardware Power Guard
After=pipewire.service pipewire-pulse.service wireplumber.service
Wants=pipewire-pulse.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/home/ryie/.local/bin/noisetorch-smart-guard.sh
ExecStop=/bin/bash -c 'while pactl list short sources 2>/dev/null | grep -q "NoiseTorch Microphone"; do /home/ryie/.local/bin/noisetorch -u >/dev/null 2>&1 || break; done'

[Install]
WantedBy=default.target
